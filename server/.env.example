PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=elearning_db
DB_DIALECT=mysql

JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=24h

# SMTP Config (Optional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@eduadmin.com
FROM_NAME=EduAdmin

# Flutter app update check (GET /api/app/version)
APP_LATEST_VERSION=1.0.2
APP_MIN_VERSION=1.0.1
APP_FORCE_UPDATE=true
APP_ANDROID_UPDATE_URL=https://play.google.com/store/apps/details?id=com.royalneetacademy.student
APP_IOS_UPDATE_URL=https://apps.apple.com/app/id000000000
APP_UPDATE_MESSAGE=A new version of Royal NEET Academy is available. Please update to continue.
